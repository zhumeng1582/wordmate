{
  "name": "wordmate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev:api": "corepack pnpm --filter @wordmate/api dev",
    "build:api": "corepack pnpm --filter @wordmate/api build",
    "dev:miniapp": "corepack pnpm --filter @wordmate/miniapp dev",
    "build:miniapp": "corepack pnpm --filter @wordmate/miniapp build",
    "test:core": "node --experimental-strip-types --test apps/api/test/core.test.ts",
    "test:ai": "node --experimental-strip-types --test packages/ai/test/*.test.ts",
    "local": "node scripts/local-dev.cjs",
    "test:smoke": "node scripts/smoke-local.cjs",
    "test:local-db": "node --test apps/api/test/local-database.test.cjs",
    "test:routes": "node scripts/smoke-inprocess.cjs",
    "test:quiz": "node --experimental-strip-types --test apps/api/test/quiz.test.ts",
    "test:history": "node --experimental-strip-types --test apps/api/test/history.test.ts",
    "test:ai:live": "node --experimental-strip-types scripts/verify-ai.cjs",
    "test:vocabulary": "node --experimental-strip-types --test apps/api/test/vocabulary.test.ts",
    "test:ai:flow": "corepack pnpm build:api && node scripts/verify-ai-flow.cjs",
    "test:tts:live": "node --experimental-strip-types scripts/verify-tts.cjs",
    "test:oss:live": "node --experimental-strip-types scripts/verify-oss.cjs",
    "test:audio": "node --experimental-strip-types --test apps/api/test/audio.test.ts",
    "test:audio:flow": "corepack pnpm build:api && node scripts/verify-audio-flow.cjs",
    "test:import-export": "node --experimental-strip-types --test apps/api/test/import-export.test.ts",
    "test:ocr:live": "corepack pnpm build:api && node scripts/verify-ocr.cjs",
    "build:release": "node scripts/build-release.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "typescript": "5.9.3"
  }
}
