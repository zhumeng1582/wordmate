# Server-only template. Fill on the server as /etc/wordmate/api.env, mode 0640,
# owned by root:wordmate. Never replace an existing production env file blindly.
# Keep any existing AI_CREDENTIAL_KEY: replacing it makes stored user keys unreadable.
NODE_ENV=production
AUTH_MODE=wechat
HOST=127.0.0.1
PORT=3000
DATABASE_URL=
DICTIONARY_PROVIDER=none
WECHAT_APP_ID=wxcf7d28bc513949d4
WECHAT_APP_SECRET=
MINIAPP_API_BASE=https://REPLACE_WITH_DOMAIN/api

LLM_PROVIDER=qwen
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-flash-2026-07-15
QWEN_BASE_URL=
OCR_PROVIDER=qwen
OCR_WORKSPACE_ID=
OCR_API_KEY=
OCR_MODEL=qwen3.7-flash-2026-07-15
TTS_PROVIDER=cosyvoice
COSYVOICE_API_KEY=
COSYVOICE_WORKSPACE_ID=
COSYVOICE_MODEL=cosyvoice-v3-flash
COSYVOICE_ENABLED_VOICES=loongemily_v3,loongeric_v3,loongabby_v3,loongandy_v3

OSS_BUCKET=
OSS_REGION=cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# For EXISTING storage, retain its saved profile/prefix and any historical profiles.
AUDIO_STORAGE_PROFILE=oss-production-1
OSS_AUDIO_PREFIX=production/audio/
OSS_POSTER_PREFIX=production/checkin/posters/
POSTER_POOL_PREWARM=false
OSS_CREDENTIAL_MODE=ecs_ram_role
OSS_RAM_ROLE_NAME=
AUDIO_SPOOL_DIR=/var/lib/wordmate/audio-spool

PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT=
PRIVACY_BACKUP_RETENTION_DAYS=
AI_CREDENTIAL_KEY=
AI_SYSTEM_DAILY_LIMIT_MICROS=20000000
AI_USER_DAILY_CALLS=100
AI_RECHARGE_ENABLED=false
WECHAT_VIRTUAL_IOS_ENABLED=false

# New speech generation consumes the family wallet; cached playback is free.
AUDIO_YUAN_PER_10000_CHARACTERS=1
