# Copy these server-only settings into .env. Never put keys in the miniapp.
# Text generation still uses LLM_PROVIDER; OCR is independently configurable.
# Leave OCR_PROVIDER empty to disable image recognition, without affecting documents.
OCR_PROVIDER=
# When enabled: OCR_PROVIDER=qwen
# Beijing workspace must have the chosen visual model enabled and sufficient quota.
OCR_WORKSPACE_ID=
OCR_API_KEY=
OCR_MODEL=qwen3.7-flash-2026-07-15
