# 0.1 Audio resource handoff. NO real credentials in this file.
# Copy needed values into the ignored root .env locally.
# CosyVoice fields are consumed by the existing provider adapter.
# Storage/cache fields below define the planned integration contract; not wired to runtime yet.
# TTS and storage are independent. New vendors require a tested registered adapter.
TTS_PROVIDER=cosyvoice
COSYVOICE_API_KEY=
COSYVOICE_WORKSPACE_ID=
COSYVOICE_MODEL=cosyvoice-v3-flash
COSYVOICE_ENABLED_VOICES=loongemily_v3,loongabby_v3

# Planned: select the write profile; persist a profile ID with every object.
# Keep old profiles configured for historical reads after changing the active profile.
AUDIO_STORAGE_PROFILE=oss-staging-1

# Provider-specific settings for the oss-staging-1 profile.
# Changing provider/bucket/region/prefix requires a NEW profile ID.
# Credentials may rotate without changing the profile ID.
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_AUDIO_PREFIX=staging/audio/
# ecs_ram_role on ECS; sts for temporary local development credentials.
OSS_CREDENTIAL_MODE=ecs_ram_role
OSS_RAM_ROLE_NAME=
# Only for local STS mode. Never put these in miniapp build variables.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=

# Planned conservative acceptance-test defaults; not currently enforced by the runtime.
AUDIO_SHARED_DICTIONARY_CACHE=false
AUDIO_WORKER_CONCURRENCY=1
AUDIO_CHILD_DAILY_ATTEMPTS=20
AUDIO_USER_DAILY_ATTEMPTS=40
AUDIO_MAX_ATTEMPTS=3
AUDIO_MAX_BYTES=10485760
API_PUBLIC_BASE_URL=
