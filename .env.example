# Server only. Copy to .env locally; do not put these values in the miniapp.
LLM_PROVIDER=qwen
# Optional legacy provider; Qwen is the default used by vocabulary and vision flows.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
# Required: an available model supporting Responses JSON Schema; pin after evaluation.
OPENAI_MODEL=
# Optional when OCR_* credentials already configure the same Bailian workspace.
# Qwen falls back to OCR_API_KEY, OCR_MODEL and OCR_WORKSPACE_ID when unset.
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-flash-2026-07-15
# Copy your official Beijing workspace compatible-mode base URL from the console.
QWEN_BASE_URL=
# Default TTS adapter: Alibaba Cloud Model Studio, Beijing.
# TTS selection is independent of LLM_PROVIDER and audio storage.
# Other TTS vendors require an implemented/registered adapter, not just a base URL.
TTS_PROVIDER=cosyvoice
COSYVOICE_API_KEY=
COSYVOICE_WORKSPACE_ID=
COSYVOICE_MODEL=cosyvoice-v3-flash
# Candidate voices; verify all enabled voices against your account before release.
COSYVOICE_ENABLED_VOICES=loongemily_v3,loongeric_v3,loongabby_v3,loongandy_v3

# WeChat login: AppID is public configuration; AppSecret stays server-side.
WECHAT_APP_ID=wxcf7d28bc513949d4
WECHAT_APP_SECRET=

# Business API. Development auth is never accepted with NODE_ENV=production.
NODE_ENV=development
AUTH_MODE=development
DICTIONARY_PROVIDER=fixture
DATABASE_URL=postgresql://wordmate:CHANGE_ME@127.0.0.1:5432/wordmate
HOST=127.0.0.1
PORT=3000
# Build-time miniapp variables must be exported in the build shell.
# MINIAPP_API_BASE=http://127.0.0.1:3000/api
# MINIAPP_DEV_AUTH=true

# Optional independent image recognition. See config/import.env.example.
OCR_PROVIDER=
OCR_WORKSPACE_ID=
OCR_API_KEY=
OCR_MODEL=qwen3.7-flash-2026-07-15

# Optional server-side check-in poster generation and private OSS cache.
# By default reuses QWEN_API_KEY/OCR_API_KEY and OCR_WORKSPACE_ID. Set these
# overrides only when the image model uses a separate key or workspace.
POSTER_IMAGE_API_KEY=
POSTER_IMAGE_WORKSPACE_ID=
POSTER_IMAGE_REGION=cn-beijing
POSTER_IMAGE_MODEL=qwen-image-2.1-turbo
# Set false for on-demand generation instead of automatic daily pool generation.
POSTER_POOL_PREWARM=false
# Reuses the configured private OSS bucket and credentials; separate object prefix.
OSS_POSTER_PREFIX=checkin/posters/

# Public policy metadata. Production consent is blocked until these are complete.
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT=
PRIVACY_BACKUP_RETENTION_DAYS=
# Required only when selecting a non-Qwen text provider.
PRIVACY_LLM_PROCESSING_REGION=
PRIVACY_LLM_POLICY_URL=

# AI accounts: server only. Required for BYOK in production; 32 random bytes as hex.
# pnpm local creates .local/ai-credential-key when unset, development only.
AI_CREDENTIAL_KEY=
# JSON array; see config/ai-models.example.json and technical/ai-accounts.txt.
# The default pinned Beijing qwen3.7-flash-2026-07-15 has a verified tiered tariff.
# Other models/regions and explicit catalogs require configured prices.
AI_MODEL_CATALOG=
AI_SYSTEM_MODEL_ID=
# Independent default image model (must be vision-capable).
AI_SYSTEM_VISION_MODEL_ID=
QWEN_VISION_API_KEY=
OPENAI_VISION_API_KEY=
# Integer micro-CNY (1 CNY = 1000000). Rolling 24-hour estimated platform cap.
AI_SYSTEM_DAILY_LIMIT_MICROS=20000000
AI_USER_DAILY_CALLS=100

# WeChat Virtual Payment (digital AI credits). Separate from merchant APIv3.
# Keep disabled until account approval, published products and real payment QA.
AI_RECHARGE_ENABLED=false
WECHAT_VIRTUAL_OFFER_ID=
WECHAT_VIRTUAL_APP_KEY=
WECHAT_VIRTUAL_NOTIFY_TOKEN=
# 43-character EncodingAESKey, JSON / AES callback mode.
WECHAT_VIRTUAL_AES_KEY=
WECHAT_VIRTUAL_IOS_ENABLED=false
# [{"id":"published-product-id","label":"AI credits","amount_fen":1000,"credit_micros":10000000}]
WECHAT_VIRTUAL_PRODUCTS=[]

# Every active family receives 20 CNY once via migration 018 / family creation trigger.
# Wallet balances are shared by all active members; text/vision BYOK keys remain personal.
