# Server only. Copy to .env locally; do not put these values in the miniapp.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
# Required: an available model supporting Responses JSON Schema; pin after evaluation.
OPENAI_MODEL=
# Only required when LLM_PROVIDER=qwen. Use a model supporting JSON Schema.
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-flash-2026-07-15
# Copy your official Beijing workspace compatible-mode base URL from the console.
QWEN_BASE_URL=
# Default TTS adapter: Alibaba Cloud Model Studio, Beijing.
# TTS selection is independent of LLM_PROVIDER and audio storage.
# Other TTS vendors require an implemented/registered adapter, not just a base URL.
TTS_PROVIDER=cosyvoice
COSYVOICE_API_KEY=
COSYVOICE_WORKSPACE_ID=
COSYVOICE_MODEL=cosyvoice-v3-flash
# Candidate voices; verify all enabled voices against your account before release.
COSYVOICE_ENABLED_VOICES=loongemily_v3,loongeric_v3,loongabby_v3,loongandy_v3

# WeChat login: AppID is public configuration; AppSecret stays server-side.
WECHAT_APP_ID=wxcf7d28bc513949d4
WECHAT_APP_SECRET=

# Business API. Development auth is never accepted with NODE_ENV=production.
NODE_ENV=development
AUTH_MODE=development
DICTIONARY_PROVIDER=fixture
DATABASE_URL=postgresql://wordmate:CHANGE_ME@127.0.0.1:5432/wordmate
HOST=127.0.0.1
PORT=3000
# Build-time miniapp variables must be exported in the build shell.
# MINIAPP_API_BASE=http://127.0.0.1:3000/api
# MINIAPP_DEV_AUTH=true

# Optional independent image recognition. See config/import.env.example.
OCR_PROVIDER=
OCR_WORKSPACE_ID=
OCR_API_KEY=
OCR_MODEL=qwen3.7-flash-2026-07-15
