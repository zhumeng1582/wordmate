# Server only. Copy to .env locally; do not put these values in the miniapp.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Required: an available model supporting Responses JSON Schema; pin after evaluation.
OPENAI_MODEL=
# Only required when LLM_PROVIDER=qwen. Use a model supporting JSON Schema.
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-flash-2026-07-15
# Copy your official Beijing workspace compatible-mode base URL from the console.
QWEN_BASE_URL=
# Domestic TTS: Alibaba Cloud Model Studio, Beijing only.
TTS_PROVIDER=cosyvoice
COSYVOICE_API_KEY=
COSYVOICE_WORKSPACE_ID=
COSYVOICE_MODEL=cosyvoice-v3-flash
# Candidate voices; verify all enabled voices against your account before release.
COSYVOICE_ENABLED_VOICES=loongemily_v3,loongeric_v3,loongabby_v3,loongandy_v3
